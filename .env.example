# --- Datenbank (Phase 1) ---
POSTGRES_USER=checkin
POSTGRES_PASSWORD=checkin
POSTGRES_DB=checkin
POSTGRES_PORT=5432
DATABASE_URL="postgresql://checkin:checkin@localhost:5432/checkin?schema=public"

# --- Auth.js (Phase 1) ---
# Generieren mit: pnpm dlx auth secret   (oder: openssl rand -base64 33)
AUTH_SECRET=

# --- Cron-Tick für Erinnerungen/Überfälligkeits-Meldungen (Phase 8) ---
# Geheimer Header-Wert, den /api/v1/cron/tick vom Aufrufer (Vercel Cron / systemd-Timer) erwartet.
CRON_SECRET=

# --- Web Push / VAPID (Phase 6) ---
# Generieren mit: pnpm dlx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:admin@internat.de"

# --- E-Mail-Versand (Phase 1: ConsoleMailer, später optional SMTP) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="CheckIn <noreply@internat.de>"

# --- Allgemein ---
# Basis-URL der Anwendung, u. a. für Links in E-Mails/Benachrichtigungen.
APP_URL=http://localhost:3000
